# =============================================================================
# ระบบจัดทำใบเสนอซื้อยาและเวชภัณฑ์ (Purchase Offer)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับโรงพยาบาล
# =============================================================================

# --- API server -------------------------------------------------------------
PORT=5174

# --- ฐานข้อมูลคลัง (PostgreSQL) ----------------------------------------------
# ไม่จำเป็นต้องกรอกที่นี่ก็ได้ — ถ้าเว้นว่าง ระบบจะให้ตั้งค่าผ่านหน้าจอตั้งค่าครั้งแรก
# แล้วเก็บไว้แบบเข้ารหัสฝั่ง server (server/.config/)
# ค่าที่กรอกตรงนี้จะถูกใช้ก่อนเสมอ (override ค่าที่บันทึกจากหน้าจอ)
INV_DB_HOST=192.168.139.131
INV_DB_PORT=5432
INV_DB_NAME=inventory
INV_DB_USER=hos
INV_DB_PASS=123456
INV_DB_SSL=false

# --- ที่เก็บ config ที่เข้ารหัส ------------------------------------------------
# กุญแจเข้ารหัสไฟล์ config หากเว้นว่าง ระบบจะสุ่มกุญแจให้เองครั้งแรก
# แล้วเก็บไว้ที่ server/.config/config.key
INV_CONFIG_KEY=
INV_CONFIG_DIR=server/.config

# --- BMS Session (ใช้สำหรับ login และอ่าน sys_var) -----------------------------
# ใส่เพื่อ prefill ตอน dev เท่านั้น ปกติผู้ใช้จะเข้ามาด้วย ?bms-session-id=GUID
BMS_SESSION_ID=
